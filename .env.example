# ---------------------------------------------------------------------------
# BizPilot AI — environment variables
# Copy to .env.local and fill in. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Database engine -------------------------------------------------------
# Leave DATABASE_URL empty to run on a local SQLite file (dev/demo mode).
# Set it to a Postgres connection string and the app switches engines on its
# own — no code change. Then run: npm run db:migrate:pg && npm run db:seed:pg
DATABASE_URL=
# Explicit engine override (only needed if you set DATABASE_URL some other way)
BIZPILOT_ENGINE=
# Apply sql/schema.sqlite.sql + seed_plans.sql + rls.postgres.sql on boot.
# Convenient for docker-compose; leave empty in production and migrate on deploy.
BIZPILOT_PG_SCHEMA=

# Supabase (optional: only if you use Supabase Auth/storage on top of Postgres)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI provider (OpenAI-compatible). Leave AI_API_KEY empty to run in
# "AI not configured" mode — the UI will say so and never fake output.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Bounded retries for 429/5xx (never for 4xx: a bad key is not transient).
AI_MAX_ATTEMPTS=3
AI_RETRY_BASE_MS=400
# Per-million-token prices used to turn the provider's token counts into a real
# cost. Leave empty and tokens are still recorded, but cost is reported as
# "not priced" instead of a misleading $0.00.
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=
# Optional: point the client at a proxy or a test double.
# AI_BASE_URL=http://127.0.0.1:4010/v1

# Stripe (test mode for development)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_AGENCY=

# Resend (transactional email)
RESEND_API_KEY=
EMAIL_FROM="BizPilot AI <no-reply@example.com>"
# Optional: self-hosted Resend-compatible proxy / test double.
# EMAIL_API_URL=http://127.0.0.1:4010/emails

# Dropbox (file storage)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REDIRECT_URI=http://localhost:3000/api/integrations/dropbox/callback
# Long-lived token produced by the OAuth flow (see README). Without it uploads stay local.
DROPBOX_ACCESS_TOKEN=
# Optional: self-hosted Dropbox-compatible proxy / test double.
# DROPBOX_CONTENT_URL=http://127.0.0.1:4010/upload
# DROPBOX_AUTHORIZE_URL / DROPBOX_TOKEN_URL override the OAuth endpoints.
# Each workspace connects its own Dropbox from /documents; the token is stored per
# organisation in integration_credentials. DROPBOX_ACCESS_TOKEN below is only a
# deployment-wide fallback for single-tenant self-hosting.

# Scheduler (time-based automations + overdue follow-ups)
# Without CRON_SECRET the cron route refuses to run, and the automations page says so.
CRON_SECRET=

# ── Local (Pakistani) payments ─────────────────────────────────────────────
# Plans are priced in USD; customers in Pakistan are quoted rupees at this rate.
# Amounts are rounded up to the next Rs 100. Default 280.
PKR_PER_USD=280

# ── Abuse limits (optional) ────────────────────────────────────────────────
# Per-IP ceilings for the auth endpoints. Defaults: 20 logins / 10 min and
# 10 signups / hour. Raise them if a whole office shares one outbound IP.
LOGIN_RATE_LIMIT=20
LOGIN_RATE_WINDOW_SECONDS=600
SIGNUP_RATE_LIMIT=10
SIGNUP_RATE_WINDOW_SECONDS=3600

# Admin bootstrap: the account created with this email gets is_super_admin = 1
# (set at sign-up time and by `npm run seed`). Leave empty to disable.
ADMIN_EMAIL=

# Public inbound lead capture endpoint (/api/leads/capture).
# Leave unset to keep the endpoint closed.
LEAD_CAPTURE_KEY=
