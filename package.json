{
  "name": "bizpilot-ai",
  "version": "0.1.0",
  "private": true,
  "description": "BizPilot AI \u2014 AI business automation & CRM SaaS for SMBs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "node scripts/db-migrate.mjs",
    "seed": "node scripts/seed.mjs",
    "db:migrate:pg": "node scripts/db-migrate.mjs",
    "db:seed:pg": "node scripts/seed.mjs --postgres",
    "dev:postgres": "next dev",
    "start:postgres": "next start",
    "test:postgres": "node scripts/test-postgres.mjs",
    "db:migrate:status": "node scripts/db-migrate.mjs --status",
    "db:migrate:down": "node scripts/db-migrate.mjs --down",
    "db:schema": "node scripts/build-schema.mjs",
    "db:backup": "node scripts/backup.mjs",
    "db:restore": "node scripts/restore.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "better-sqlite3": "^11.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "next": "^15.5.29",
    "pg": "^8.23.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^15.5.29",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.29",
    "eslint-plugin-react-hooks": "^5.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.74.0",
    "vitest": "^2.1.8"
  }
}
